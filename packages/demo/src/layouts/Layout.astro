---
import '@styles/main.css';

interface Props {
    title: string;
    scrollOrientation?: 'vertical' | 'horizontal';
}

const { title, scrollOrientation = 'vertical' } = Astro.props;

// public/ files are served under the base (/demo); BASE_URL may or may not end with a slash
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const FONTS: string[] = [
    // 'WebfontRegular.woff2',
    // 'WebfontBold.woff2',
]
---

<!doctype html>
<html lang="en" data-scroll-orientation-settings={scrollOrientation}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        {FONTS.map(font =>
            <link
                rel="preload"
                href={`${base}/fonts/${font}`}
                as="font"
                type="font/woff2"
                crossorigin
            />
        )}

    </head>
    <body>
        <main role="main" id="swup" class="transition-fade">
            <div id="content">
                <slot />
            </div>
        </main>
        <script src="../scripts/app.ts"></script>
    </body>
</html>
