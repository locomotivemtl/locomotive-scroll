---
import '@styles/main.css';
import helveticaRegular from '@src/assets/fonts/HelveticaNowDisplay-Regular.woff2?url';
import helveticaMedium from '@src/assets/fonts/HelveticaNowDisplay-Medium.woff2?url';
import locomotiveLight from '@src/assets/fonts/PPLocomotiveNew-Light.woff2?url';

interface Props {
    title: string;
    scrollOrientation?: 'vertical' | 'horizontal';
    infinite?: boolean;
}

const { title, scrollOrientation = 'vertical', infinite = false } = Astro.props;

// public/ files are served under the base (/demo); BASE_URL may or may not end with a slash
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Same URLs as the @font-face rules in main.css, so the preloads are reused
const FONTS: string[] = [helveticaRegular, helveticaMedium, locomotiveLight];
---

<!doctype html>
<html lang="en" data-scroll-orientation-settings={scrollOrientation} data-scroll-infinite-settings={infinite ? "" : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        {FONTS.map(font =>
            <link
                rel="preload"
                href={font}
                as="font"
                type="font/woff2"
                crossorigin
            />
        )}

    </head>
    <body>
        <main role="main" id="swup" class="transition-fade">
            <div id="content">
                <slot />
            </div>
        </main>
        <script src="../scripts/app.ts"></script>
    </body>
</html>
