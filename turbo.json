{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "bundled/**",
        ".next/**",
        "!.next/cache/**",
        ".docusaurus/**"
      ],
      "cache": true
    },
    "@locomotivemtl/astro-boilerplate#build": {
      "dependsOn": ["^build"],
      "outputs": ["../../www/demo/**"],
      "cache": true
    },
    "docs-v-2#build": {
      "dependsOn": ["^build"],
      "outputs": [".docusaurus/**", "../../www/docs/**"],
      "cache": true
    },
    "@locomotivemtl/boilerplate#build": {
      "dependsOn": ["^build"],
      "outputs": ["../../www/landing/**"],
      "cache": true
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
