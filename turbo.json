{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "bundled/**",
        ".next/**",
        "!.next/cache/**",
        ".docusaurus/**",
        "build/**",
        "../../www/demo/**",
        "../../www/docs/**"
      ],
      "cache": true
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
